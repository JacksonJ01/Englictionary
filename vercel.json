{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel:build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/output/spherical/Englictionary.html"
    },
    {
      "source": "/spherical",
      "destination": "/output/spherical/Englictionary.html"
    }
  ]
}
